# Browser: blank values use same-origin /api and /socket.io.
# Packaged Electron: defaults to https://palmdesk-hk-test.ziniaocloud.com (API uses /api).
VITE_API_BASE_URL=
VITE_SIGNALING_URL=

# Packaged Electron defaults to https://palmdesk-hk-test.ziniaocloud.com/ for phone invites.
# Override with a phone-accessible client homepage, e.g. https://remote.example.com/
# LAN debugging: http://192.168.1.10:5173/ (not localhost).
VITE_CLIENT_BASE_URL=

# Example: turn:relay.example.com:3478?transport=udp
# These client values are public. Never put a coturn shared secret here.
# Blank values use session credentials from the backend automatically.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

VITE_ENABLE_UPSTREAM_VERSION_CHECK=false
VITE_OPEN_DEVTOOLS=false
