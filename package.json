{
  "name": "palmdesk",
  "version": "0.0.7",
  "private": true,
  "description": "AI-native remote control for desktop apps: stream one macOS or Windows window to your phone for agent-ready workflows.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.16.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Abreto/palmdesk.git"
  },
  "homepage": "https://github.com/Abreto/palmdesk#readme",
  "bugs": {
    "url": "https://github.com/Abreto/palmdesk/issues"
  },
  "license": "MIT",
  "author": "Abreto (https://github.com/Abreto)",
  "contributors": [
    "shuisheng (https://github.com/galaxy-s10)",
    "xiaolu289 (https://github.com/xiaolu289)"
  ],
  "type": "module",
  "main": "electron-dist/index.cjs",
  "scripts": {
    "build:beta": "cross-env VITE_APP_RELEASE_PROJECT_ISWEB=true vite build",
    "build:prod": "cross-env VITE_APP_RELEASE_PROJECT_ISWEB=true vite build",
    "cz": "cz",
    "dev": "node scripts/dev.mjs",
    "dev:desktop": "node scripts/dev.mjs",
    "dev:desktop:lan": "node scripts/dev.mjs --host 0.0.0.0",
    "dev:web": "cross-env VITE_APP_RELEASE_PROJECT_ISWEB=true vite --host 127.0.0.1",
    "dev:web:lan": "cross-env VITE_APP_RELEASE_PROJECT_ISWEB=true vite --host 0.0.0.0",
    "build:native": "node scripts/build-native.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:desktop:win": "node scripts/build-desktop.mjs --win",
    "dist:mac": "node scripts/build-desktop.mjs --mac --installer",
    "dist:win": "node scripts/build-desktop.mjs --win --installer",
    "doctor:desktop": "node scripts/check-desktop-identity.cjs",
    "typecheck": "vue-tsc --noEmit",
    "test:smoke": "node --test test/smoke/*.test.cjs session-core/test/*.test.mjs",
    "test:session-core": "node --test session-core/test/*.test.mjs",
    "gen-icons": "node scripts/generate-icons.mjs",
    "lint": "eslint . --config ./eslint.config.js --cache",
    "lint:fix": "eslint . --config ./eslint.config.js --cache --fix",
    "preview": "vite preview",
    "release": "standard-version"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.2",
    "@nut-tree-fork/shared": "^4.2.2",
    "@vicons/ionicons5": "^0.12.0",
    "@vueuse/components": "^11.1.0",
    "@vueuse/core": "^10.10.0",
    "axios": "^1.4.0",
    "billd-deploy": "^1.1.0",
    "billd-html-webpack-plugin": "^1.2.0",
    "billd-scss": "^0.0.8",
    "billd-utils": "^0.0.25",
    "highlight.js": "^11.12.0",
    "js-cookie": "^3.0.5",
    "markdown-it": "^15.0.2",
    "naive-ui": "^2.34.4",
    "pinia": "^2.1.6",
    "pinia-plugin-persistedstate": "^3.2.1",
    "qr-scanner": "^1.4.2",
    "socket.io-client": "^4.8.0",
    "spark-md5": "^3.0.2",
    "vconsole": "^3.15.1",
    "vue": "^3.5.13",
    "vue-i18n": "^9",
    "vue-router": "^4.2.4"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron/rebuild": "^3.6.0",
    "@eslint/js": "^9.10.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^20.4.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-legacy": "^5.3.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^11.0.3",
    "commitizen": "^4.3.1",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-define-config": "^2.1.0",
    "eslint-import-resolver-typescript": "^3.6.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^9.28.0",
    "icon-gen": "2.1.0",
    "postcss-preset-env": "^10.1.2",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "sass": "^1.63.6",
    "standard-version": "^9.5.0",
    "trash": "^8.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "unplugin-auto-import": "^0.17.6",
    "unplugin-vue-components": "^0.25.1",
    "vite": "^6.0.3",
    "vite-plugin-checker": "^0.8.0",
    "vite-plugin-commonjs": "^0.10.1",
    "vite-plugin-electron": "^0.28.2",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vite-plugin-eslint2": "^5.0.3",
    "vite-plugin-html": "^3.2.2",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.1.10"
  },
  "productName": "PalmDesk"
}
